{
  "name": "the-stone-gambit",
  "private": true,
  "version": "1.0.0",
  "description": "Playable 3D wizard's chess with a browser-based opponent and cinematic stone captures.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:public": "node scripts/verify-public.mjs",
    "check": "npm run format:check && npm test && npm run build && npm run verify:public",
    "audit:anatomy": "node scripts/audit-anatomy.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "mp4-muxer": "^5.2.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.1.4",
    "prettier": "3.9.6"
  }
}
